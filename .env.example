# ============================================================
# huly-gitlab — environment variable reference
# Copy to .env and fill in real values before running compose.
# ============================================================

# ------------------------------------------------------------
# pod-gitlab — service config  (src/config.ts)
# ------------------------------------------------------------

# TCP port the pod listens on (default: 3600)
PORT=3600

# Public base URL of this pod (used for OAuth callback & webhook registration)
# Example: http://localhost:3600
PUBLIC_BASE_URL=http://localhost:3600

# Huly account service URL (internal compose address)
ACCOUNTS_URL=http://account:3000

# Shared secret that authorises calls between Huly services
SERVER_SECRET=change-me-shared-secret

# Logical service identifier (default: gitlab-service)
SERVICE_ID=gitlab-service

# MongoDB connection string for pod-gitlab state
MONGO_URL=mongodb://mongo:27017

# MongoDB database name (default: huly-gitlab)
MONGO_DB=huly-gitlab

# GitLab instance base URL (self-hosted or gitlab.com)
GITLAB_BASE_URL=http://gitlab:8929

# GitLab OAuth application credentials (create under Admin > Applications)
GITLAB_CLIENT_ID=your-gitlab-oauth-app-id
GITLAB_CLIENT_SECRET=your-gitlab-oauth-app-secret

# 32-byte key (base64-encoded) used to encrypt stored OAuth tokens
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY=

# Seed for HMAC webhook secret generation (any random string)
WEBHOOK_SECRET_SEED=change-me-webhook-seed

# Comma-separated list of allowed Huly workspace IDs, or '*' for all
ALLOWED_WORKSPACES=*

# How often to run the backfill polling cycle in milliseconds (default: 300000 = 5 min)
BACKFILL_INTERVAL_MS=300000

# GitLab API rate-limit: max requests per second (default: 25)
RATE_LIMIT=25

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Path to branding JSON file (leave empty for default)
BRANDING_PATH=

# ------------------------------------------------------------
# Huly stack — mirrors .template.huly.conf
# ------------------------------------------------------------

# Huly image version tag (all hardcoreeng/* images)
HULY_VERSION=v0.7.423

# Desktop update channel (matches HULY_VERSION patch)
DESKTOP_CHANNEL=0.7.423

# Compose project name
DOCKER_NAME=huly-gitlab-dev

# External hostname / IP from which the Huly UI will be reached
# (used to construct FRONT_URL, ACCOUNTS_URL, etc.)
HOST_ADDRESS=localhost

# Set to 's' to enable HTTPS/WSS; leave empty for plain HTTP/WS
SECURE=

# HTTP binding for the nginx reverse proxy
HTTP_PORT=8087
HTTP_BIND=0.0.0.0

# Huly UI branding
TITLE=Huly Self Host
DEFAULT_LANGUAGE=en
LAST_NAME_FIRST=true

# CockroachDB — primary Huly data store
CR_DATABASE=huly
CR_USERNAME=huly
CR_USER_PASSWORD=huly-cockroach-secret
CR_DB_URL=postgres://huly:huly-cockroach-secret@cockroach:26257/huly

# Redpanda (Kafka-compatible) — event queue for Huly services
REDPANDA_ADMIN_USER=admin
REDPANDA_ADMIN_PWD=redpanda-admin-secret

# Shared Huly JWT secret (must match SERVER_SECRET above for same deploy)
SECRET=change-me-shared-secret
