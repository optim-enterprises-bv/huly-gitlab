{
  "name": "huly-gitlab",
  "version": "0.1.0",
  "private": true,
  "license": "EPL-2.0",
  "description": "Two-way Issues sync between Huly workspace and GitLab projects",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --passWithNoTests --coverage",
    "test:e2e": "jest --config jest.e2e.config.js --passWithNoTests",
    "dev": "nodemon --watch src --ext ts --exec 'ts-node src/index.ts'",
    "bundle": "node esbuild.js",
    "docker:build": "docker build -t hardcoreeng/huly-gitlab ."
  },
  "dependencies": {
    "@hcengineering/account-client": "^0.7.423",
    "@hcengineering/analytics": "^0.7.423",
    "@hcengineering/analytics-service": "^0.7.423",
    "@hcengineering/chunter": "^0.7.423",
    "@hcengineering/client": "^0.7.423",
    "@hcengineering/client-resources": "^0.7.423",
    "@hcengineering/contact": "^0.7.423",
    "@hcengineering/core": "^0.7.423",
    "@hcengineering/measurements": "^0.7.423",
    "@hcengineering/mongo": "^0.7.423",
    "@hcengineering/platform": "^0.7.423",
    "@hcengineering/query": "^0.7.423",
    "@hcengineering/server-client": "^0.7.423",
    "@hcengineering/server-core": "^0.7.423",
    "@hcengineering/server-token": "^0.7.423",
    "@hcengineering/setting": "^0.7.423",
    "@hcengineering/task": "^0.7.423",
    "@hcengineering/text": "^0.7.423",
    "@hcengineering/text-markdown": "^0.7.423",
    "@hcengineering/tracker": "^0.7.423",
    "@tiptap/core": "^2.11.7",
    "@tiptap/html": "^2.11.7",
    "@tiptap/pm": "^2.11.7",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fast-equals": "^5.2.2",
    "graphql": "^16.8.0",
    "graphql-request": "^7.1.0",
    "helmet": "^7.2.0",
    "markdown-it": "^14.0.0",
    "mongodb": "^6.16.0",
    "ws": "^8.18.2"
  },
  "overrides": {
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.5",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "eslint-config-love": "^43.1.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nock": "^14.0.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.6.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
